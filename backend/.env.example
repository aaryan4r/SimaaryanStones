# Server-only settings. Never commit actual values.
DATABASE_URL=
ADMIN_USERNAME=
# Produce a hash locally with scripts/hash-password.js; do not store the password itself.
ADMIN_PASSWORD_HASH=
# Random, unique secret of at least 32 characters.
SESSION_SECRET=
# Exact public frontend origin, no path or trailing slash; comma-separated for multiple origins.
CORS_ORIGIN=
# Railway supplies PORT. Set only for local use.
PORT=3000
